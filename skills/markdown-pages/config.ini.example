; Copy to config.ini in the deck root.
; Project keys live here. Per-book keys live in that directory's meta.toml.
; [serve] port: make serve listens here; document root is [paths] build_root
;         (default build/).
;
; Each book directory has meta.toml:
;         type: pages for this skill. Other values (slides, ...) are not built here.
;         name: output basename under build/<name>/. Letters, digits, hyphens.
;         title: HTML document title. Defaults to name when omitted.
; [book] order: auto (default) sorts NN-slug.md and NNN-slug.md by filename.
; [book] sort: optional Markdown file, relative to the pages directory,
;         whose heading links set the chapter order. Do not set order and
;         sort together. Example: sort = "index.md"
;
; [paths] skills_root: optional directory of installed skills. The trampoline
;         looks for <skills_root>/markdown-slides and
;         <skills_root>/markdown-pages (each with scripts/). Relative to the
;         deck root. When unset, it tries .agents/skills/<name>, then
;         ~/.agents/skills/<name>. Override with SKILL /
;         MARKDOWN_SLIDES_HOME / MARKDOWN_PAGES_HOME.
; [paths] build_root: artifact directory (default build). Relative to the
;         deck root, or absolute. make serve uses this as the document root.
;
; [assets] webfont: off (default) or on. When on, HTML inlines @font-face
;         from the skill .cache/fonts/ populated by `make fonts`. Missing
;         cache falls back to system fonts; viewing never hits Google Fonts.
; MathJax is vendored under vendor/mathjax/ and copied into build assets.
;
; Artifacts: <build_root>/<name>/index.html, chapter pages, <name>.html, <name>.pdf
;         make html <name>      multi-page site + one-file HTML
;         make pdf <name>       PDF from the one-file HTML
;         make serve            preview <build_root>/
;         make fonts            download Google Fonts into skill caches

[serve]
port = 8000

; [paths]
; skills_root = skills
; build_root = build

; [assets]
; webfont = off
