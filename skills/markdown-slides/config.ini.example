; Copy to config.ini in the deck root.
; name: output basename. Letters, digits, and hyphens only.
;       When missing or empty, defaults to the deck directory name.
; title: HTML document title. Defaults to name when empty.
; slides: slide directory relative to the deck root. Defaults to slides.
;         Absolute paths, and ".." that escapes the deck root, are rejected.
; order: auto (default) sorts NNN-slug.md files in slides/ by filename.
; sort: optional Markdown file, relative to the deck root, whose ## Slides
;       links set the page order. Do not set order and sort together.
;       Example: sort = examples/slides/index.md
; [build] skill: markdown-slides engine directory. Relative to the deck
;         root, absolute, or ~. May leave the deck root. SKILL and
;         MARKDOWN_SLIDES_HOME override this value. Omit it when running
;         make from the skill directory itself.
;         Example: skill = ../markdown-slides
; [build] theme: template directory under the skill templates/.
;         Defaults to swiss-modern. Letters, digits, and hyphens only.

[deck]
name = markdown-slides-examples
title = Markdown Slides Examples
slides = examples/slides
order = auto

[build]
; skill =
theme = swiss-modern

[cover]
presenter =
presented_at =

[serve]
port = 8000
