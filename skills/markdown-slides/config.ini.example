; Copy to config.ini in the deck root.
; Project keys live here. Per-slides keys live in that directory's meta.toml.
; [serve] port: make serve listens here; document root is [paths] build_root
;         (default build/).
;
; Each page directory has meta.toml:
;         type: slides for this skill. Other values (ebook, ...) are not built here.
;         name: output basename under build/<slides>/. Letters, digits, hyphens.
;         title: HTML document title. Defaults to name when omitted.
;         theme: look name. Letters, digits, and hyphens only.
;         Resolved from the deck themes/<theme>/ when that copy is
;         complete, else skill templates/<theme>/. Defaults to
;         swiss-modern. Bundled: swiss-modern, paper-ink,
;         terminal-green, blue-professional.
; [deck] order: auto (default) sorts NNN-slug.md files by filename.
; [deck] sort: optional Markdown file, relative to the slides directory,
;         whose ## Slides links set the page order. Do not set order and
;         sort together. Example: sort = "index.md"
; [cover] presenter / presented_at: optional overrides when a page is
;         010-cover.md. Empty values do not override frontmatter.
;
; [paths] skills_root: optional directory of installed skills. The trampoline
;         looks for <skills_root>/markdown-slides and
;         <skills_root>/markdown-pages (each with scripts/). Relative to the
;         deck root. When unset, it tries .agents/skills/<name>, then
;         ~/.agents/skills/<name>. Override with SKILL /
;         MARKDOWN_SLIDES_HOME / MARKDOWN_PAGES_HOME.
; [paths] build_root: artifact directory (default build). Relative to the
;         deck root, or absolute. make serve uses this as the document root.
;
; Artifacts: <build_root>/<slides>/<name>.html / .pptx / .pdf
;         make slides           HTML for that type=slides directory
;         make ppt slides       PPTX
;         make pdf slides       PDF
;         make serve            preview <build_root>/

[serve]
port = 8000

; [paths]
; skills_root = skills
; build_root = build
